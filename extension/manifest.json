{
  "manifest_version": 3,
  "name": "Shelf Check for Australian Libraries (unofficial)",
  "description": "Shows which library has each book on the shelf right now, and recommends books you will like that are available near you. Brisbane, Gold Coast, Tasmania, Melbourne and Canberra.",
  "version": "0.2.0",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shelf Check"
  },
  "content_scripts": [
    {
      "matches": [
        "https://library-brisbane.ent.sirsidynix.net.au/client/*",
        "https://librarycatalogue.goldcoast.qld.gov.au/client/*",
        "https://librariestas.ent.sirsidynix.net.au/client/*",
        "https://librarysearch.melbourne.vic.gov.au/cgi-bin/*",
        "https://librariesact.spydus.com/cgi-bin/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.mjs",
        "options.html"
      ],
      "matches": [
        "https://library-brisbane.ent.sirsidynix.net.au/*",
        "https://librarycatalogue.goldcoast.qld.gov.au/*",
        "https://librariestas.ent.sirsidynix.net.au/*",
        "https://librarysearch.melbourne.vic.gov.au/*",
        "https://librariesact.spydus.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
