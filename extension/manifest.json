{
  "manifest_version": 3,
  "name": "Shelf Check for Brisbane Libraries (unofficial)",
  "description": "Shows which Brisbane City Council library has each book on the shelf right now, right in the catalogue search results.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Shelf Check" },
  "content_scripts": [
    {
      "matches": ["https://library-brisbane.ent.sirsidynix.net.au/client/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/catalogue.mjs", "lib/branches.json"],
      "matches": ["https://library-brisbane.ent.sirsidynix.net.au/*"]
    }
  ]
}
