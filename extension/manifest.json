{
  "manifest_version": 3,
  "name": "Shelf Check for Brisbane Libraries (unofficial)",
  "description": "Shows which Brisbane City Council library has each book on the shelf right now, and recommends books you will like that are available near you.",
  "version": "0.2.0",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shelf Check"
  },
  "content_scripts": [
    {
      "matches": [
        "https://library-brisbane.ent.sirsidynix.net.au/client/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.mjs",
        "options.html"
      ],
      "matches": [
        "https://library-brisbane.ent.sirsidynix.net.au/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
